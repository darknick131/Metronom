<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootScrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:fillViewport="true"
    tools:context=".MainActivity">

<androidx.constraintlayout.widget.ConstraintLayout
    android:id="@+id/mainContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="24dp">

    <!-- Title -->
    <TextView
        android:id="@+id/titleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textSize="32sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="32dp" />

    <!-- Song Library & Start Buttons - MOVED TO TOP -->
    <LinearLayout
        android:id="@+id/navigationSection"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/navigation_background"
        android:padding="20dp"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/titleText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Section Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Controls"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <!-- Navigation Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/songLibraryButton"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="Song Library"
                android:textColor="@color/white"
                app:icon="@drawable/ic_music_note"
                app:iconTint="@color/white"
                app:backgroundTint="@color/blue_accent"
                app:cornerRadius="12dp"
                style="@style/Widget.Material3.Button" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/startStopButton"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="@string/start"
                android:textColor="@color/white"
                app:icon="@drawable/ic_play"
                app:iconTint="@color/white"
                app:backgroundTint="@color/purple_accent"
                app:cornerRadius="12dp"
                style="@style/Widget.Material3.Button" />

        </LinearLayout>

    </LinearLayout>

    <!-- Beat Visualizer -->
    <com.metronom.app.ui.BeatVisualizerView
        android:id="@+id/beatVisualizer"
        android:layout_width="0dp"
        android:layout_height="200dp"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/navigationSection"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Beat Counter -->
    <TextView
        android:id="@+id/beatCounter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="1"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:background="@drawable/beat_counter_professional"
        android:padding="8dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/beatVisualizer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Tempo Display -->
    <TextView
        android:id="@+id/tempoValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="120"
        android:textSize="64sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        app:layout_constraintTop_toBottomOf="@id/beatCounter"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="24dp" />

    <TextView
        android:id="@+id/bpmLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="BPM"
        android:textSize="18sp"
        android:textColor="@color/white"
        android:alpha="0.7"
        app:layout_constraintTop_toBottomOf="@id/tempoValue"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp" />

    <!-- Tempo Slider -->
    <com.google.android.material.slider.Slider
        android:id="@+id/tempoSlider"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:valueFrom="40"
        android:valueTo="200"
        android:value="120"
        android:stepSize="1"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toBottomOf="@id/bpmLabel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:thumbColor="@color/blue_accent"
        app:trackColorActive="@color/blue_accent"
        app:trackColorInactive="@color/white_alpha_30" />

    <!-- Latency Section -->
    <TextView
        android:id="@+id/latencyLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Audio Latency"
        android:textSize="16sp"
        android:textColor="@color/white"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toBottomOf="@id/tempoSlider"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/latencyValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="50ms"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="@color/blue_accent"
        app:layout_constraintTop_toBottomOf="@id/tempoSlider"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="32dp" />

    <!-- Latency Slider -->
    <com.google.android.material.slider.Slider
        android:id="@+id/latencySlider"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:valueFrom="0"
        android:valueTo="200"
        android:value="50"
        android:stepSize="1"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/latencyLabel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:thumbColor="@color/purple_accent"
        app:trackColorActive="@color/purple_accent"
        app:trackColorInactive="@color/white_alpha_30" />

    <!-- Latency Presets -->
    <LinearLayout
        android:id="@+id/latencyPresets"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/latencySlider"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/speakersButton"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Speakers"
            android:layout_marginEnd="8dp"
            android:textColor="@color/white"
            app:strokeColor="@color/white_alpha_50" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/headphonesButton"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Earbuds"
            android:layout_marginStart="8dp"
            android:textColor="@color/white"
            app:strokeColor="@color/white_alpha_50" />

    </LinearLayout>

    <!-- Sound Selection Section -->
    <TextView
        android:id="@+id/soundLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Sound"
        android:textSize="16sp"
        android:textColor="@color/white"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toBottomOf="@id/latencyPresets"
        app:layout_constraintStart_toStartOf="parent" />

    <LinearLayout
        android:id="@+id/soundButtons"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/soundLabel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/clickButton"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Click"
            android:layout_marginEnd="4dp"
            android:textColor="@color/white"
            app:strokeColor="@color/white_alpha_50" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/beepButton"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Beep"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:textColor="@color/white"
            app:strokeColor="@color/white_alpha_50" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/tickButton"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Tick"
            android:layout_marginStart="4dp"
            android:textColor="@color/white"
            app:strokeColor="@color/white_alpha_50" />

    </LinearLayout>

    <!-- Custom Sound Section -->
    <TextView
        android:id="@+id/customSoundLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Custom Sound"
        android:textSize="16sp"
        android:textColor="@color/white"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/soundButtons"
        app:layout_constraintStart_toStartOf="parent" />

    <LinearLayout
        android:id="@+id/customSoundButtons"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/customSoundLabel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/uploadSoundButton"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Upload"
            android:layout_marginEnd="8dp"
            android:textColor="@color/white"
            app:strokeColor="@color/white_alpha_50" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/clearCustomSoundButton"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Clear"
            android:layout_marginStart="8dp"
            android:textColor="@color/white"
            app:strokeColor="@color/white_alpha_50" />

    </LinearLayout>

    <TextView
        android:id="@+id/customSoundStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="No custom sound loaded"
        android:textSize="12sp"
        android:textColor="@color/white"
        android:alpha="0.6"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/customSoundButtons"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />



</androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>